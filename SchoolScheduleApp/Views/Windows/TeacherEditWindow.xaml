<Window x:Class="SchoolScheduleApp.Views.Windows.TeacherEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SchoolScheduleApp.Views.Windows"
        Title="Редактирование" Width="460"
        SizeToContent="Height" MinHeight="320" MaxHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent">

    <Border CornerRadius="15" Background="{DynamicResource WindowBackground}" 
            BorderBrush="{DynamicResource AccentColor}" BorderThickness="1">
        <Grid Margin="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                <TextBlock Text="Редактирование учителя" Foreground="{DynamicResource PrimaryText}" 
                           FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                <!-- Поле ФИО -->
                <TextBlock Text="ФИО Преподавателя:" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Teacher.FullName}" Height="35" Padding="5" 
                         Background="{DynamicResource InputBackground}" 
                         Foreground="{DynamicResource PrimaryText}" 
                         BorderBrush="{DynamicResource CardBorder}"/>
                <TextBlock Text="Предмет:" Foreground="{DynamicResource SecondaryText}" Margin="0,15,0,5"/>

                <!-- ComboBox без локальных ресурсов: цвета и Popup берутся из темы + MaterialDesign -->
                <ComboBox ItemsSource="{Binding Subjects}"
                         DisplayMemberPath="Name"
                         SelectedValuePath="Id"
                         SelectedValue="{Binding Teacher.SubjectId}"
                         Height="35"/>

                <!-- Быстрое добавление нового предмета (без отдельного окна) -->
                <DockPanel Margin="0,10,0,0">
                    <TextBox x:Name="TbNewSubject" Width="240" Height="32" Padding="8,0"
                             VerticalContentAlignment="Center"
                             Background="{DynamicResource InputBackground}"
                             Foreground="{DynamicResource PrimaryText}"
                             BorderBrush="{DynamicResource CardBorder}"/>

                    <Button Content="Добавить" Width="100" Height="32" Margin="10,0,0,0"
                            Background="Transparent"
                            Foreground="{DynamicResource AccentColor}"
                            BorderBrush="{DynamicResource AccentColor}"
                            BorderThickness="1"
                            Cursor="Hand"
                            Click="BtnAddSubject_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </DockPanel>
                <!-- Кнопки -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,0">
                    <Button Content="Отмена" IsCancel="True" Click="BtnCancel_Click"
                            Background="Transparent" Foreground="{DynamicResource SecondaryText}" 
                            BorderThickness="0" Margin="0,0,10,0" Cursor="Hand"/>

                    <Button Content="Сохранить" IsDefault="True" Click="BtnSave_Click"
                            Background="{DynamicResource AccentColor}" Foreground="White" 
                            FontWeight="Bold" Padding="15,8" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
